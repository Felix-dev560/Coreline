# Copy to .env and edit. Never commit the real .env file.

NODE_ENV=production
PORT=3000

# REQUIRED in production. At least 32 random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the SQLite file lives. Put this on a persistent disk on your host.
DB_PATH=./data/ringline.db

# Set to 1 when the app sits behind a proxy or host load balancer (Render, Railway, Nginx, Caddy).
TRUST_PROXY=1

# Optional. Comma separated list of origins allowed to open the WebSocket.
# Leave empty to allow only the same host the page was loaded from.
ALLOWED_ORIGINS=

# Optional. Defaults to true when NODE_ENV=production. Set false only for plain http testing.
COOKIE_SECURE=

# Calls work directly between most networks using STUN. Some mobile and office networks
# need a TURN relay. Without TURN, those calls will fail to connect.
STUN_URLS=stun:stun.l.google.com:19302
# Example: turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
# Option A (recommended, coturn "use-auth-secret"): short lived credentials are generated per login.
TURN_SECRET=
# Option B: fixed username and password.
TURN_USERNAME=
TURN_CREDENTIAL=
